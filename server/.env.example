# Environment variables declared in this file are automatically made available to Prisma.
# See the documentation for more detail: https://pris.ly/d/prisma-schema#accessing-environment-variables-from-the-schema

# ============================================
# Option 1: PostgreSQL (Production/Cloud)
# ============================================
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/z0_db?schema=public"

# ============================================
# Option 2: SQLite (Local/Offline Development)
# Uncomment the line below and comment out PostgreSQL
# ============================================
# DATABASE_URL="file:./dev.db"

# ============================================
# Application Settings
# ============================================
JWT_SECRET="your-jwt-secret-key-here"
RESEND_API_KEY="your-resend-api-key-here"
CLIENT_URL="http://localhost:3000"
NODE_ENV=development
PORT=8080

# ============================================
# Sync Settings (for Offline-First)
# ============================================
SYNC_ENABLED=false          # Enable offline sync queue
REMOTE_DATABASE_URL=""     # Remote PostgreSQL for sync
